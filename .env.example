# ============================================================
# Variables de entorno del backend ERP
# Copiar a .env para desarrollo local.
# En Render se cargan desde Dashboard > Environment.
# ============================================================

# --- MongoDB ---
# Local:
# MONGODB_URL=mongodb://localhost:27017/erp_db
# DATABASE_NAME=erp_db
# Producción (MongoDB Atlas):
MONGODB_URL=mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/web-erp?retryWrites=true&w=majority&appName=Cluster0
# Si se omite, se deduce del propio MONGODB_URL
DATABASE_NAME=web-erp

# --- CORS ---
# Acepta JSON o lista separada por comas. Debe incluir el dominio del frontend.
# Desarrollo: CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
CORS_ORIGINS=["https://tu-app.vercel.app"]

# --- Entorno ---
# DEBUG=False deshabilita /docs y /redoc
DEBUG=False
ENVIRONMENT=production

# --- Seguridad ---
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria

# --- Almacenamiento de archivos SIRE ---
# En Render el disco es efímero: usar /tmp o montar un disco persistente
SIRE_FILE_STORAGE=/tmp/sire_files

# --- Credenciales SUNAT / SIRE (opcionales) ---
SUNAT_RUC=
SUNAT_USUARIO=
SUNAT_CLAVE_SOL=
SUNAT_CLIENT_ID=
SUNAT_CLIENT_SECRET=

# Clave Fernet para cifrar claves SOL y client_secret en Mongo.
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SIRE_ENCRYPTION_KEY=

# --- Puerto ---
# Render lo inyecta automáticamente; no hace falta definirlo allí.
PORT=8000
