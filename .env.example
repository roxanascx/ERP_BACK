# Variables de entorno para el backend

# MongoDB Connection
# Para desarrollo local:
# MONGODB_URL=mongodb://localhost:27017/erp_db
# DATABASE_NAME=erp_db
# Para producción / nube (MongoDB Atlas):
MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/web-erp?retryWrites=true&w=majority&appName=Cluster0
# Nombre de la base de datos. Si se omite, se deduce del propio MONGODB_URL.
DATABASE_NAME=web-erp

# CORS origins
# Para desarrollo:
# CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:5173"]
# Para producción (agregar tu dominio de Vercel):
CORS_ORIGINS=["https://tu-app.vercel.app", "http://localhost:5173"]

# Clerk Webhook Secret (obtener de Clerk Dashboard > Webhooks)
CLERK_WEBHOOK_SECRET=whsec_...

# Configuración del entorno
DEBUG=False
ENVIRONMENT=production

# Puerto para Render (automático)
PORT=10000

# Clave Fernet para cifrar claves SOL y client_secret en Mongo.
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SIRE_ENCRYPTION_KEY=
